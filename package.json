	},
	"engines": {
		"node": ">=22.14.0",
		"npm": ">=10.3.0"
	},
	"volta": {
		"node": "22.14.0",
		"npm": "10.3.0"
	},
	"scripts": {
		"lint": "eslint . && tsc --noEmit",
		"lint:fix": "eslint . --fix",
		"wp-env": "wp-env",
		"wp-env:start": "wp-env start",
		"wp-env:stop": "wp-env stop",
		"build": "wp-scripts build gutenberg.ts=./src/gutenberg.ts --output-path=./public/dist",
		"dev": "wp-scripts start gutenberg.ts=./src/gutenberg.ts --output-path=./public/dist",
		"pack": "./bin/build-plugin.sh"
	},
	"prettier": "@wordpress/prettier-config",
	"devDependencies": {
